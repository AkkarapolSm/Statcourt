# ==============================================================================
# StatCourtTH Environment Configuration Template
# Copy this file to .env and provide your secrets
# ==============================================================================

# Database Connection (SQLite local persistent engine)
DATABASE_URL="file:./dev.db"

# Official Session HMAC Cryptographic Secret (Minimum 32 characters)
OFFICIAL_SESSION_SECRET="your-strong-random-hmac-sha256-secret-at-least-32-chars"

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
